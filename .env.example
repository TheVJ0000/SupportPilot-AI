# AI provider
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-3.8-flash
GEMINI_TRIAGE_MODEL=gemini-3.8-flash
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=768

# Optional server-only email (leave blank to retain pending notifications at ₹0)
# Arbitrary recipients require an already-owned, Resend-verified sender domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Supabase browser/client (publishable; access remains constrained by RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase backend/server
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Application
APP_ENV=
FRONTEND_URL=
BACKEND_URL=
VITE_API_BASE_URL=
